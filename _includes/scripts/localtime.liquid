<script>
  // Day counts and dates, recomputed in the viewer's own timezone.
  //
  // Everything dated on this site is rendered twice: once by Liquid at build
  // time, so the page is right without JavaScript, and again here. The build
  // runs on a UTC runner, so a day counter written there ticks over at 5pm in
  // California and at other wrong moments everywhere else. These handlers move
  // the tick to the viewer's own midnight, and keep the numbers right on the
  // days between builds.
  //
  //   data-local-days="YYYY-MM-DD"   whole local days since that date
  //     data-local-days-offset="1"   ...counting the start date itself
  //     data-local-days-format="for" ...rendered as "for N days"
  //   data-local-date="<epoch>"      that instant, in the viewer's locale
  //   data-local-year                the viewer's current year
  //
  // Every handler leaves the server-rendered text alone if anything is off, so
  // a bad attribute degrades to the build-time value rather than to a blank.
  (function () {
    function localMidnight(iso) {
      var parts = String(iso || '').split('-');
      if (parts.length !== 3) return null;
      var date = new Date(+parts[0], +parts[1] - 1, +parts[2]);
      return isNaN(date.getTime()) ? null : date;
    }

    function daysSince(start) {
      var today = new Date();
      today.setHours(0, 0, 0, 0);
      // Round rather than floor: a local day is 23 or 25 hours long across a
      // DST boundary, and flooring those loses or gains a day for months.
      return Math.round((today - start) / 86400000);
    }

    function each(selector, fn) {
      Array.prototype.forEach.call(document.querySelectorAll(selector), fn);
    }

    each('[data-local-days]', function (el) {
      var start = localMidnight(el.getAttribute('data-local-days'));
      if (!start) return;
      var days = daysSince(start) + (+el.getAttribute('data-local-days-offset') || 0);
      if (!isFinite(days) || days < 0) return;
      el.textContent = el.getAttribute('data-local-days-format') === 'for' ? 'for ' + days + (days === 1 ? ' day' : ' days') : String(days);
    });

    each('[data-local-date]', function (el) {
      var seconds = +el.getAttribute('data-local-date');
      if (!seconds) return;
      var when = new Date(seconds * 1000);
      if (isNaN(when.getTime())) return;
      try {
        el.textContent = when.toLocaleDateString(undefined, {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
      } catch (error) {
        // Intl unavailable: the build-time date stands.
      }
    });

    each('[data-local-year]', function (el) {
      el.textContent = String(new Date().getFullYear());
    });
  })();
</script>
